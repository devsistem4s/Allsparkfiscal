LOCAL_UID=1000
LOCAL_GID=1000
API_PORT=8088
# Homologation / Production issuance switch. Both API and engine enforce this switch.
ENABLE_ISSUANCE=true
TENANT_RATE_PER_SECOND=200
WORKER_CONCURRENCY=8

# GitHub & GitHub Container Registry (GHCR) Deploy Configuration
GITHUB_ORG=SPOLTEC
GITHUB_USER=SPOLTEC
GITHUB_REPO=https://github.com/SPOLTEC/Allsparkfiscal.git
GITHUB_TOKEN=replace_with_your_github_pat_token
GHCR_REGISTRY=ghcr.io/spoltec/allsparkfiscal
IMAGE_TAG=latest
STACK_NAME=allspark
